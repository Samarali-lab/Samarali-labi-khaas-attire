# Database
DATABASE_URL="postgresql://user:password@localhost:5432/khaas_attire"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="7d"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email (Resend)
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@khaasattire.com"

# Stripe
STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key"

# JazzCash
JAZZCASH_MERCHANT_ID="your-merchant-id"
JAZZCASH_PASSWORD="your-password"
JAZZCASH_INTEGRITY_SALT="your-integrity-salt"

# Easypaisa
EASYPAISA_STORE_ID="your-store-id"
EASYPAISA_HASH_KEY="your-hash-key"

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER="923001234567"

# Backend API
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
PORT=4000

# Admin
ADMIN_EMAIL="admin@khaasattire.com"
ADMIN_PASSWORD="change-this-password"

# SMS Gateway (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="your-twilio-phone"
